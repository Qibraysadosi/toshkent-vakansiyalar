{
  "name": "toshkent-vakansiyalar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import": "tsx scripts/import.ts",
    "import:dry": "tsx scripts/import.ts --dry-run",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/schema.sql",
    "db:reset": "psql \"$DATABASE_URL\" -c \"drop table if exists vacancies, companies, synonyms, search_logs, subscriptions, import_history cascade\" && npm run db:schema",
    "enrich": "tsx scripts/enrich.ts",
    "enrich:probe": "tsx scripts/enrich.ts --probe",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "notify": "tsx scripts/notify.ts"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^16.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "xlsx": "^0.18.5"
  }
}
