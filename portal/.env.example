# ---------------------------------------------------------------------------
# Ma'lumot bazasi
# ---------------------------------------------------------------------------
# Lokal Postgres (npm run db:up bilan ko'tariladi):
DATABASE_URL=postgresql://vak:vak@127.0.0.1:5432/vakansiyalar
#
# Supabase (Dashboard -> Settings -> Database -> Connection string -> URI):
# Vercel'da "Transaction pooler" (port 6543) manzilini ishlating.
# DATABASE_URL=postgresql://postgres.xxxx:PAROL@aws-0-xxx.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Sayt
# ---------------------------------------------------------------------------
# Kanonik manzil — sitemap, robots.txt va OG rasmlar uchun
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel paroli (5-bosqich). Bo'sh bo'lsa /admin ochilmaydi.
ADMIN_PASSWORD=

# Telegram bot (7-bosqich). @BotFather dan token oling, keyin:
#   npm run telegram:setup     — webhook'ni saytga bog'laydi
TG_BOT_TOKEN=
# Webhook'ni begona so'rovlardan himoya qiladi — istalgan uzun tasodifiy satr
TG_WEBHOOK_SECRET=
# Bot username'i (@'siz) — saytdagi "Yangi vakansiyalardan xabardor bo'ling" CTA
# havolasi (footer, bo'sh natija). Bo'sh bo'lsa CTA ko'rsatilmaydi.
NEXT_PUBLIC_TG_BOT=
